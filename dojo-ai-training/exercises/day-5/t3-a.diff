diff --git a/task-tracker/src/tasks/dto/create-task.dto.spec.ts b/task-tracker/src/tasks/dto/create-task.dto.spec.ts
new file mode 100644
index 0000000..e3818c6
--- /dev/null
+++ b/task-tracker/src/tasks/dto/create-task.dto.spec.ts
@@ -0,0 +1,26 @@
+import { plainToInstance } from 'class-transformer';
+import { validate } from 'class-validator';
+import { CreateTaskDto } from './create-task.dto';
+import { UpdateTaskDto } from './update-task.dto';
+
+describe.each([
+  ['CreateTaskDto', CreateTaskDto],
+  ['UpdateTaskDto', UpdateTaskDto],
+])('%s dueDate', (_name, Dto) => {
+  const errorsFor = async (dueDate: unknown) => {
+    const errors = await validate(plainToInstance(Dto, { title: 'Weekly Report', dueDate }));
+    return errors.filter((e) => e.property === 'dueDate');
+  };
+
+  it('accepts a YYYY-MM-DD date', async () => {
+    expect(await errorsFor('2026-03-20')).toHaveLength(0);
+  });
+
+  it('rejects a full timestamp', async () => {
+    expect(await errorsFor('2026-03-19T17:00:00.000Z')).toHaveLength(1);
+  });
+
+  it('rejects a date that does not exist', async () => {
+    expect(await errorsFor('2026-02-30')).toHaveLength(1);
+  });
+});
