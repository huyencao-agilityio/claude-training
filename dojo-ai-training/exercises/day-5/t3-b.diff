+++ b/task-tracker/src/tasks/dto/task-dto.spec.ts
@@ -0,0 +1,29 @@
+import { plainToInstance } from 'class-transformer';
+import { validate } from 'class-validator';
+import { CreateTaskDto } from './create-task.dto';
+import { UpdateTaskDto } from './update-task.dto';
+
+describe.each([
+  ['CreateTaskDto', CreateTaskDto],
+  ['UpdateTaskDto', UpdateTaskDto],
+])('%s dueDate', (_name, Dto) => {
+  const dueDateErrors = async (dueDate: unknown) => {
+    const errors = await validate(plainToInstance(Dto, { title: 'Weekly Report', dueDate }));
+    return errors.filter((e) => e.property === 'dueDate');
+  };
+
+  it('accepts a YYYY-MM-DD calendar date', async () => {
+    expect(await dueDateErrors('2026-03-20')).toHaveLength(0);
+  });
+
+  it.each(['2026-03-19T17:00:00.000Z', '2026-03-20T00:00:00+07:00'])(
+    'rejects a timestamp (%s)',
+    async (value) => {
+      expect(await dueDateErrors(value)).toHaveLength(1);
+    },
+  );
+
+  it.each(['2026-02-30', '20-03-2026', '2026-3-20'])('rejects an invalid date (%s)', async (value) => {
+    expect(await dueDateErrors(value)).toHaveLength(1);
+  });
+});
