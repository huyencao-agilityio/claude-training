+
+      expect(updated.dueDate).toBe('2026-03-20');
+    });
+
+    it('keeps the due date when an update does not send one', async () => {
+      repository.findOneBy.mockResolvedValue(task('2026-03-20'));
+
+      const updated = await service.update(task(null).id, { title: 'Weekly Report v2' });
+
+      expect(updated.dueDate).toBe('2026-03-20');
+    });
+
+    it.each([
+      ['false on the last minute of the due date', '2026-03-20T23:59:00Z', '2026-03-20', false],
+      ['true from the start of the next day', '2026-03-21T00:00:00Z', '2026-03-20', true],
+      ['false before the due date', '2026-03-19T17:00:00Z', '2026-03-20', false],
+    ])('isOverdue is %s in UTC by default', async (_when, now, dueDate, expected) => {
+      jest.useFakeTimers().setSystemTime(new Date(now));
+      repository.findOneBy.mockResolvedValue(task(dueDate));
+
+      await expect(service.findOne('id')).resolves.toMatchObject({ isOverdue: expected });
+    });
+
+    it('ends the due day in DUE_DATE_TIMEZONE when set', async () => {
+      process.env.DUE_DATE_TIMEZONE = 'Asia/Ho_Chi_Minh';
+      // 21 March 00:30 in Vietnam, still 20 March in UTC
+      jest.useFakeTimers().setSystemTime(new Date('2026-03-20T17:30:00Z'));
+      repository.findOneBy.mockResolvedValue(task('2026-03-20'));
+
+      await expect(service.findOne('id')).resolves.toMatchObject({ isOverdue: true });
+    });
+
+    it('is not overdue for a done task past its due date', async () => {
+      jest.useFakeTimers().setSystemTime(new Date('2026-03-25T00:00:00Z'));
+      repository.findOneBy.mockResolvedValue(task('2026-03-20', 'done'));
+
+      await expect(service.findOne('id')).resolves.toMatchObject({ isOverdue: false });
+    });
+  });
 });
