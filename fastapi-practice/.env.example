DEBUG=false

# Postgres (matches docker-compose.yml)
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/fastapi_practice

# Clerk: Dashboard → Configure → API keys → "Frontend API URL"
CLERK_ISSUER=https://your-app.clerk.accounts.dev
# Optional, defaults to ${CLERK_ISSUER}/.well-known/jwks.json
CLERK_JWKS_URL=
# JSON list of frontend origins allowed in the token's `azp` claim
CLERK_AUTHORIZED_PARTIES=["http://localhost:3000"]
CLERK_LEEWAY_SECONDS=5
